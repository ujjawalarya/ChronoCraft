{
  "name": "ChronoCraft",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "screenshots": "node scripts/capture_screenshots.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^4.0.0",
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
